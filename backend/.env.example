# Copia este archivo a .env y ajusta los valores.

# Nombre de la plataforma
PLATFORM_NAME=Brota

# Base de datos PostgreSQL
DATABASE_URL=postgresql+psycopg://brotas:brotas@localhost:5432/brotas

# Seguridad (JWT)
SECRET_KEY=cambia-esta-clave-secreta-por-una-mas-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (orígenes separados por comas)
CORS_ORIGINS=http://localhost:5173

# Fotos en Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=productos
